# Express API
PORT=4000
CORS_ORIGIN=http://localhost:3000
API_URL=http://127.0.0.1:4000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password

# Local Supabase values for running the API directly on Windows.
# Replace the key placeholders with values from: npm run supabase:status
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=<local publishable or anon key>
SUPABASE_SECRET_KEY=<local secret or service_role key>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Docker Desktop values used by compose.yaml from inside the API container.
DOCKER_SUPABASE_URL=http://host.docker.internal:54321
DOCKER_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
